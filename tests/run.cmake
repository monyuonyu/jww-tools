# ctest driver: convert every test drawing and compare entity counts with tests/expected.txt
file(STRINGS ${SRC}/tests/expected.txt cases)
set(failed 0)
foreach(line IN LISTS cases)
  string(REPLACE " " ";" parts "${line}")
  list(GET parts 0 name)
  list(REMOVE_AT parts 0)
  set(out ${CMAKE_CURRENT_BINARY_DIR}/test_${name}.dxf)
  execute_process(COMMAND ${JWW2DXF} -q --explode --hatch ${SRC}/tests/data/${name} -o ${out} RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(SEND_ERROR "${name}: jww2dxf exit ${rc}")
    math(EXPR failed "${failed}+1")
    continue()
  endif()
  file(STRINGS ${out} lines)
  set(in_ent 0)
  set(prev "")
  set(counts "")
  foreach(l IN LISTS lines)
    string(STRIP "${l}" l)
    if(prev STREQUAL "2" AND l STREQUAL "ENTITIES")
      set(in_ent 1)
    elseif(in_ent AND prev STREQUAL "0")
      if(l STREQUAL "ENDSEC")
        set(in_ent 0)
      else()
        list(APPEND counts ${l})
      endif()
    endif()
    set(prev "${l}")
  endforeach()
  foreach(p IN LISTS parts)
    string(REPLACE "=" ";" kv "${p}")
    list(GET kv 0 type)
    list(GET kv 1 want)
    set(n 0)
    foreach(c IN LISTS counts)
      if(c STREQUAL type)
        math(EXPR n "${n}+1")
      endif()
    endforeach()
    if(NOT n EQUAL want)
      message(SEND_ERROR "${name}: ${type} ${n}, expected ${want}")
      math(EXPR failed "${failed}+1")
    endif()
  endforeach()
endforeach()
if(failed)
  message(FATAL_ERROR "${failed} check(s) failed")
endif()
message(STATUS "all test drawings converted as expected")
